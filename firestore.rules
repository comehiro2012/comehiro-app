rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 予約はCloud Functions（Admin SDK）だけが作成します。
    // Firebase Authenticationでログイン済みの管理者は、閲覧と対応状況の更新だけを行えます。
    match /mail/{document=**} {
      allow create, delete: if false;
      allow read, update: if request.auth != null;
    }
  }
}
